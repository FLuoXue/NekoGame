  "scripts": {
    "start": "chcp 65001 && electron .",
    "build": "electron-builder"
  },
  "keywords": [],
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.23",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.4.0",
    "iconv-lite": "^0.7.3",
    "node-fetch": "^3.3.2",
    "ps-node": "^0.1.6",
    "qs": "^6.16.0",
    "sqlite3": "^6.0.1",
    "winreg": "^1.2.5",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "com.wenpeng.nekogame",
    "productName": "NekoGame",
    "copyright": "Copyright © 2023",
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "extraMetadata": {
      "version": "2.3.17"
    },
    "files": [
      "assets/**/*",
      "src/**/*"
    ],
    "directories": {
